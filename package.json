{
  "name": "@waldbaer/node-red-persistent-values",
  "version": "1.6.1",
  "description": "A user-friendly abstraction of the Node-RED context stores.",
  "author": "waldbaer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waldbaer/node-red-persistent-values.git"
  },
  "keywords": [
    "node-red",
    "context",
    "persistence",
    "persistency",
    "state",
    "config",
    "storage"
  ],
  "node-red": {
    "version": ">=1.3.0",
    "nodes": {
      "persistent values config": "nodes/persistent-values-config.js",
      "persistent value": "nodes/persistent-value.js"
    }
  },
  "//": "engines.node: uuid 14 is an ES module. require() loads ES modules by default only on Node.js 20.19+ and 22.12+ (not on 21.x). The 22 line starts at 22.9 to match the minimum of Node-RED 5, although 22.9 to 22.11 cannot load uuid 14.",
  "engines": {
    "node": "^20.19.0 || >=22.9.0"
  },
  "dependencies": {
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.12.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "mocha": "11.7.6",
    "mocha-suppress-logs": "0.6.0",
    "node-red": "5.0.7",
    "node-red-dev": "0.1.6",
    "node-red-node-test-helper": "0.3.6",
    "nyc": "18.0.0"
  },
  "nyc": {
    "check-coverage": true,
    "reporter": ["lcov", "text", "text-summary"],
    "branches": 100,
    "lines": 100,
    "functions": 100,
    "statements": 100
  },
  "scripts": {
    "test": "mocha \"test/**/*_spec.js\"",
    "coverage": "nyc npm test",
    "lint": "eslint nodes resources test",
    "node-red-dev-validate": "node-red-dev validate -p ."
  }
}
